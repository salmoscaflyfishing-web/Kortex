# Copie ce fichier sous le nom .env.local, puis colle tes clés après le signe =
# Ne mets jamais .env.local sur GitHub.

# Clé Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase : https://supabase.com/dashboard > ton projet > bouton « Connect »
# (la clé « publishable » peut être vue dans le navigateur, c'est normal)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
